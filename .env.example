# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ──────────────────────────────────────────────
# JWT  ← CHANGE in production!
# ──────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-please-change-in-production

# ──────────────────────────────────────────────
# AI Models  (set at least one)
# ──────────────────────────────────────────────
# Google Gemini
GEMINI_API_KEY=

# Mathpix (fallback)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/h2k_storage

# AWS S3 (set STORAGE_BACKEND=s3 to enable)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=handwrite2katex
# S3_REGION=ap-northeast-2

# MinIO (set STORAGE_BACKEND=minio to enable)
# MINIO_ENDPOINT=http://localhost:9000
