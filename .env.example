# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ──────────────────────────────────────────────
# Ports
# ──────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# HTTPS (optional — requires SSL certs + nginx reverse proxy)
# HTTPS_PORT=8443
# SSL_CERT_PATH=./certs/server.crt
# SSL_KEY_PATH=./certs/server.key

# ──────────────────────────────────────────────
# JWT  ← CHANGE in production!
# ──────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-please-change-in-production

# ──────────────────────────────────────────────
# Admin account (optional)
# ──────────────────────────────────────────────
# 기본 admin 계정이 없으면 app 시작 시 자동 생성됩니다.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin1234

# ──────────────────────────────────────────────
# AI Models  (set at least one)
# ──────────────────────────────────────────────
# Google Gemini
GEMINI_API_KEY=

# Mathpix (fallback)
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/h2k_storage

# AWS S3 (set STORAGE_BACKEND=s3 to enable)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=handwrite2katex
# S3_REGION=ap-northeast-2

# MinIO (set STORAGE_BACKEND=minio to enable)
# MINIO_ENDPOINT=http://localhost:9000
