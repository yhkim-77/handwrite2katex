# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ──────────────────────────────────────────────
# Ports
# ──────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# HTTPS (optional — requires SSL certs + nginx reverse proxy)
# HTTPS_PORT=8443
# SSL_CERT_PATH=./certs/server.crt
# SSL_KEY_PATH=./certs/server.key

# ──────────────────────────────────────────────
# JWT  ← CHANGE in production!
# ──────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-please-change-in-production

# ──────────────────────────────────────────────
# Admin account (optional)
# ──────────────────────────────────────────────
# 기본 admin 계정이 없으면 app 시작 시 자동 생성됩니다.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=Admin1234

# ──────────────────────────────────────────────
# AI Models  (set at least one)
# 인식기 우선순위: pix2tex → Groq → Gemini → Mathpix → Mock
# ──────────────────────────────────────────────

# [1순위] Groq Vision API — 무료 tier 제공
# 발급: https://console.groq.com
#   1. 회원가입 / 로그인
#   2. 좌측 메뉴 "API Keys" → "Create API Key"
#   3. 생성된 키 복사 (gsk_ 로 시작)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# [2순위] Google Gemini — 무료 1,500 req/day
# 발급: https://aistudio.google.com
#   1. Google 계정으로 로그인
#   2. 상단 "Get API key" 버튼 클릭
#   3. "Create API key" → 프로젝트 선택 후 생성 (AIzaSy 로 시작)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# [3순위] Mathpix OCR — 수식 특화 최고 정확도, 무료 100 req/월
# 발급: https://mathpix.com
#   1. 회원가입 / 로그인
#   2. 우측 상단 아바타 → "Account" → "API Keys" 탭
#   3. "Create App" → App Name 입력 → APP_ID 와 APP_KEY 복사
MATHPIX_APP_ID=
MATHPIX_APP_KEY=

# ──────────────────────────────────────────────
# Storage
# ──────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/h2k_storage

# AWS S3 (set STORAGE_BACKEND=s3 to enable)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=handwrite2katex
# S3_REGION=ap-northeast-2

# MinIO (set STORAGE_BACKEND=minio to enable)
# MINIO_ENDPOINT=http://localhost:9000
